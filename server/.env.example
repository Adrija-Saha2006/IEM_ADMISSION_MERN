# Copy this file to ".env" and fill in your values.

# MongoDB connection string.
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/iem_admission
# Or MongoDB Atlas (recommended — free cloud DB):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/iem_admission

# Secret used to sign login tokens (change to any long random string).
JWT_SECRET=change_this_to_a_long_random_secret

# Port the API runs on.
PORT=5000

# Where the React app is served from (for CORS). Vite dev default:
CLIENT_URL=http://localhost:5173
